<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PlogPatrol - My Events</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="css/Gallery.css">
    <link rel="stylesheet" href="css/Events.css">
    <style>
        /* General Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Roboto', sans-serif;
        }
        body {
            background-color: #f8f8f8;
            padding: 20px;
            line-height: 1.6;
        }
        .nav-links {
            display: flex;
            gap: 15px;
        }
        .nav-links a {
            text-decoration: none;
            color: #333;
            font-weight: 600;
        }
        .nav-links a:hover {
            text-decoration: underline;
        }
        /* Search Section */
        .search-section {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }
        #search-bar {
            width: 60%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        #search-button {
            padding: 10px 20px;
            background-color: #68a72e;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        #search-button:hover {
            background-color: #4a8c23;
        }
        /* Filter Section */
        .filter-section {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
            padding: 10px;
            border-radius: 10px;
            background-color: #ffffff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            flex-wrap: wrap;
        }
        .filter-section label {
            margin-right: 10px;
            font-weight: bold;
        }
        .filter-section input {
            padding: 5px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        #apply-filter {
            padding: 10px 20px;
            background-color: #68a72e;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        #apply-filter:hover {
            background-color: #4a8c23;
        }
        /* Event Section */
        .events-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .event {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        }
        .event:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
        }
        .event img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .event-details {
            padding: 15px;
        }
        .event-details h2 {
            font-size: 20px;
            margin-bottom: 10px;
        }
        .event-details p {
            font-size: 14px;
            margin-bottom: 10px;
        }
        /* Footer */
        footer {
            background-color: #b3f14eac;
            color: black;
            padding: 20px;
            font-family: 'Roboto', sans-serif;
        }
        .footer-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            max-width: 1200px;
            margin: auto;
            padding: 0 20px;
        }
        .footer-section {
            flex: 1;
            margin: 10px;
        }
        .footer-section h2 {
            border-bottom: 2px solid black;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }
        .footer-section a {
            color: black;
            text-decoration: none;
        }
        .footer-section a:hover {
            text-decoration: underline;
        }
        .footer-bottom {
            text-align: center;
            padding: 10px;
            background-color: #b3f14edd;
        }
    </style>
</head>
<body>
    <!-- Main Content -->
    <div id="content">
        <div data-role-header="user" data-logout-mode="auto"></div>
    <script src="/js/roleHeaders.js"></script>
<br><br>
        <section class="search-section">
            <input type="text" id="search-bar" placeholder="Search events by title or description">
            <button id="search-button">Search</button>
        </section>
    
        <!-- Filter Section -->
        <section class="filter-section">
            <label for="filter-title">Filter by Title:</label>
            <input type="text" id="filter-title" placeholder="Event title">
    
            <label for="filter-location">Filter by Location:</label>
            <input type="text" id="filter-location" placeholder="Event location">
    
            <label for="filter-date">Filter by Date:</label>
            <input type="date" id="filter-date">
            
            <button id="apply-filter">Apply Filters</button>
        </section>
    
        <!-- Event Listing Section -->
        <section class="events-section" id="events-list">
            <% rows.map((eachRow)=>{ %>
            <div class="event">
                <img src="images/Image1.jpg" alt="Event Image" class="event-image">
            </div>
                <div class="event-details">
                    <h2><%- eachRow.e_srno -%></h2>
                        <h2><%- eachRow.e_name -%></h2>
                        <p><strong>Date:</strong> <%- eachRow.e_date -%></p>
                        <p><strong>Location:</strong> <%- eachRow.e_loc -%></p>
                        <p><%- eachRow.e_desc -%></p>
                      
                        <a href=joinEvent?eid=<%-eachRow.e_srno -%>>Join Event</a>
                    </div>
          <% }) %>
        </section>
        
    </div>
    <!-- Footer Section -->
    <div data-role-footer="user"></div>
    <script src="/js/roleFooters.js"></script>
    <!-- <script src="js/UserEvents.js"></script> -->
</body>
</html>
